<?xml version="1.0"?>
<!--
  Domyślny plik konfiguracyjny LMMS dla Raspberry Pi 5 (PipeWire / KDE Plasma 6).

  DLACZEGO PulseAudio?
  Na Pi z PipeWire LMMS przy pustym ustawieniu "audiodev" próbuje backendów
  w kolejności: SDL -> ALSA -> PulseAudio -> ... i wybiera PIERWSZY, który
  "otworzy" urządzenie. Backend ALSA na Pi potrafi otworzyć urządzenie z
  pominięciem routingu PipeWire -> w efekcie LMMS "gra", ale nie słychać nic.
  Backend "PulseAudio" łączy się przez pipewire-pulse i jest potwierdzonym,
  działającym wyjściem dźwięku (strumień 48 kHz float32 2ch -> HDMI).

  Instalacja (jako użytkownik, NIE root):
    cp /opt/lmms/lmmsrc.xml ~/.lmmsrc.xml
  (nadpisuje poprzedni ~/.lmmsrc.xml, który mógł zapisać zły backend)

  Jeśli wolisz inny backend, zmień audiodev na jedną z nazw:
    - ALSA:      "ALSA (Advanced Linux Sound Architecture)"
    - JACK:      "JACK (JACK Audio Connection Kit)"
    - SDL:       "SDL (Simple DirectMedia Layer)"
    - Dummy:     "Dummy (no sound output)"
-->
<lmms version="1.3.0-alpha" configversion="3">
  <!-- audioengine/audiodev = wymuszony backend PulseAudio (przez pipewire-pulse) -->
  <audioengine audiodev="PulseAudio" samplerate="48000" framesperaudiobuffer="256" sanitizemix="1" />
</lmms>
